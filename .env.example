# Copy this file to .env and fill in the values from Google Cloud Console (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed for Google Ads stats (see README, "Marketing"):
GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_API_VERSION=v26
# PORT=3000

# Ad Studio (see README, "Ad Studio"):
# Claude writes your ads. Get a key at https://console.anthropic.com (Settings → API keys).
ANTHROPIC_API_KEY=
# Meta (Facebook + Instagram) system-user access token with ads_management.
META_ACCESS_TOKEN=
# Optional but recommended: your Meta app's secret (App settings → Basic), signs every request.
META_APP_SECRET=
# Optional: set these here instead of picking them in Ad Studio → Meta setup.
# META_AD_ACCOUNT_ID=
# META_PAGE_ID=
# META_API_VERSION=v26.0
